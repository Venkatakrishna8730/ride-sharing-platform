              "raw": "{{baseUrl}}/api/v1/trips/rider?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trips", "rider"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
