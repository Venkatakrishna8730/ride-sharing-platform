            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetStatus\": \"ACCEPTED\",\n  \"driverId\": \"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips/{{tripId}}/status",
